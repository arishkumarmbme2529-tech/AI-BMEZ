# Application Settings
APP_NAME="AICTE Smart Document Management Platform"
APP_VERSION="1.0.0"

# Security
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://aicte_user:aicte_password@localhost:5432/aicte_platform

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Optional: Tesseract OCR path (Windows example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
